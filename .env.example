# ═══════════════════════════════════════════════════════════════
# 🌟 Novarito Discord Bot — Configuración del Entorno (.env)
# ═══════════════════════════════════════════════════════════════

# Discord Credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
OWNER_DISCORD_ID=

# Render & Web Server Port
PORT=3000

# Firebase Service Account Credentials (Realtime Database & Firestore)
FIREBASE_PROJECT_ID=alero-company-works
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=https://alero-company-works-default-rtdb.firebaseio.com

# AI Providers API Keys (Chat & Memoria Dual)
GROQ_API_KEY=
GROQMEMORY_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MEMORY_API_KEY=
HUGGINGFACE_API_KEY=

# Novarito Personality & Visual Engine Settings
NOVARITO_DEBUG=false
NOVARITO_TYPING_EFFECT=true
NOVARITO_HUMOR_LEVEL=0.7
NOVARITO_FALLBACK_TIMEOUT_MS=12000
